<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cecsmsserve.mapper.SysFunctionMapper">
    <resultMap id="SysFunctionResultMap" type="com.cecsmsserve.entity.SysFunction">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="path" property="path" />
        <result column="fId" property="parentId" />
        <result column="icon" property="icon" />
        <result column="sort" property="sort" />
        <result column="state" property="state" />
    </resultMap>

    <select id="selectAll" resultMap="SysFunctionResultMap">
        SELECT id, name, path, fId, icon, sort, state
        FROM sys_function
        ORDER BY sort
    </select>

    <select id="selectByRid" resultMap="SysFunctionResultMap">
        SELECT s.id, s.name, s.path, s.fId, s.icon, s.sort, s.state
        FROM sys_function s
        INNER JOIN role_function r ON s.id = r.fId
        WHERE r.rId = #{rid}
        ORDER BY s.sort
    </select>
</mapper>
