# Reference only: Spring Boot does not automatically load this file.
# Prefer scripts/docker-dev.ps1 redis, which writes the ignored IDEA/CLI host profile.
CECSMS_DB_URL=jdbc:mysql://127.0.0.1:3306/a_old?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia%2FShanghai&sslMode=DISABLED&allowPublicKeyRetrieval=true
CECSMS_DB_USERNAME=root
CECSMS_DB_PASSWORD=replace-with-local-mysql-password
CECSMS_JWT_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=replace-with-a-rotated-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_API_KEY=replace-with-volcengine-ark-api-key
DOUBAO_MODEL=replace-with-ark-endpoint-or-model-id
CECSMS_MCP_API_KEY=replace-with-a-dedicated-random-mcp-key
CECSMS_AGENT_CONFIRMATION_TTL=10m
CECSMS_AGENT_RATE_LIMIT=12
CECSMS_AGENT_HISTORY_LIMIT=20
CECSMS_KNOWLEDGE_BASE_PATH=..\..\knowledge-base\ima-ready
CECSMS_UPLOAD_DIR=D:\\silverpilot-data\\uploads
# Optional read-only fallback root for existing image/file/video directories.
CECSMS_ASSET_DIR=
# Supported Local mode injects these values from the generated Docker environment.
CECSMS_REDIS_ENABLED=true
CECSMS_REDIS_HOST=127.0.0.1
CECSMS_REDIS_PORT=6380
CECSMS_REDIS_PASSWORD=replace-with-local-redis-password
CECSMS_REDIS_HEALTH_ENABLED=true
CECSMS_MIGRATE_LEGACY_PASSWORDS=true
CECSMS_SCHEMA_MIGRATION_ENABLED=true
CECSMS_CAPTCHA_RATE_LIMIT=30
CECSMS_LOGIN_RATE_LIMIT=8
CECSMS_CAPTCHA_TTL=5m
CECSMS_CAPTCHA_MAX_LOCAL_ENTRIES=10000
# Enable forwarded headers only when the application is behind a trusted, header-sanitizing proxy.
CECSMS_FORWARD_HEADERS_STRATEGY=NONE
CECSMS_AI_MOCK_ENABLED=false
CECSMS_AI_MAX_COMPLETION_TOKENS=1800
CECSMS_AI_MAX_TOTAL_TOKENS=12000
CECSMS_AI_RETRY_MAX_ATTEMPTS=2
CECSMS_AI_RETRY_BACKOFF=350ms
