{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: install clean dependencies",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\..\\..\\scripts\\start-local-frontend.ps1",
        "-InstallOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\..\\.."
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev server",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: stop dev server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\..\\..\\scripts\\stop-local-frontend.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\..\\.."
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: full check",
      "type": "shell",
      "command": "npm run check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
