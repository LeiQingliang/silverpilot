# SilverPilot Docker environment template. Copy to .env.docker or run:
#   .\scripts\docker-dev.ps1 redis
# The helper generates strong local secrets for every __GENERATE__ value.
# A Git-ignored DPAPI backup is maintained for the current Windows user so an
# accidentally removed .env.docker can be restored without rotating data-volume credentials.
COMPOSE_PROJECT_NAME=silverpilot
SILVERPILOT_MYSQL_DATABASE=a_old
SILVERPILOT_MYSQL_USER=cecsms
SILVERPILOT_MYSQL_ROOT_PASSWORD=__GENERATE__
SILVERPILOT_DB_PASSWORD=__GENERATE__
SILVERPILOT_REDIS_PASSWORD=__GENERATE__
SILVERPILOT_JWT_SECRET=__GENERATE__
SILVERPILOT_MCP_API_KEY=__GENERATE__

# Host ports deliberately avoid the normal IDEA/VSCode/local-service ports.
SILVERPILOT_MYSQL_PORT=3307
SILVERPILOT_REDIS_PORT=6380
SILVERPILOT_BACKEND_PORT=8083
SILVERPILOT_FRONTEND_PORT=8082

# Optional model providers. Keep empty until configured locally.
SILVERPILOT_DEEPSEEK_API_KEY=
SILVERPILOT_DEEPSEEK_MODEL=deepseek-v4-flash
SILVERPILOT_DEEPSEEK_THINKING_ENABLED=false
SILVERPILOT_DOUBAO_API_KEY=
SILVERPILOT_DOUBAO_MODEL=

SILVERPILOT_AGENT_RATE_LIMIT=12
SILVERPILOT_CAPTCHA_TTL=5m
SILVERPILOT_CAPTCHA_MAX_LOCAL_ENTRIES=10000
SILVERPILOT_AI_MOCK_ENABLED=false
SILVERPILOT_LOG_LEVEL=INFO
