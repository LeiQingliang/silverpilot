# Deny by default. This Dockerfile uses the repository root as its context.
**
!SourceCode/
!SourceCode/cecsmsServe-springboot/
!SourceCode/cecsmsServe-springboot/.mvn/
!SourceCode/cecsmsServe-springboot/.mvn/wrapper/
!SourceCode/cecsmsServe-springboot/.mvn/wrapper/maven-wrapper.properties
!SourceCode/cecsmsServe-springboot/mvnw
!SourceCode/cecsmsServe-springboot/mvnw.cmd
!SourceCode/cecsmsServe-springboot/pom.xml
!SourceCode/cecsmsServe-springboot/src/
!SourceCode/cecsmsServe-springboot/src/main/java/**/*.java
!SourceCode/cecsmsServe-springboot/src/test/java/**/*.java
!SourceCode/cecsmsServe-springboot/src/main/resources/application.properties
!SourceCode/cecsmsServe-springboot/src/main/resources/schema.sql
!SourceCode/cecsmsServe-springboot/src/main/resources/mapper/*.xml
!SourceCode/cecsmsServe-springboot/src/main/resources/prompts/*.md
!SourceCode/cecsmsServe-springboot/src/test/resources/application-test.properties
!SourceCode/cecsmsServe-springboot/src/test/resources/asset-fixtures/image/*.txt
!SourceCode/cecsmsServe-springboot/src/test/resources/legacy-asset-fixtures/image/*.txt
!knowledge-base/
!knowledge-base/ima-ready/
!knowledge-base/ima-ready/*.md
!image/
!image/**/*.png
!image/**/*.jpg
!image/**/*.jpeg
!image/**/*.webp
!image/**/*.gif
!file/
!file/**/*.pdf
!file/**/*.doc
!file/**/*.docx
!file/**/*.xls
!file/**/*.xlsx
!file/**/*.txt
!file/README.md
!video/
!video/**/*.mp4
!video/**/*.webm
!video/.gitkeep
!deploy/
!deploy/railway/
!deploy/railway/backend-entrypoint.sh
!deploy/railway/backend.Dockerfile
!deploy/railway/backend.Dockerfile.dockerignore

# Defense in depth for files introduced under otherwise allowed source paths.
**/.git
**/.env
**/.env.*
**/config/application-host.properties
**/application-host.properties
**/application-local.properties
**/application-private.properties
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.log
**/target
**/node_modules
**/backups
**/logs
